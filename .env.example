# Path of the SQLite file (node:sqlite, built into Node 22+). Mount a persistent volume here in production.
DATABASE_PATH=./data/app.db
# Public origin of this app. Shown in the embed snippet customers copy.
NEXT_PUBLIC_SITE_URL=http://localhost:3410
# Optional: set both to turn on Pro checkout. Empty = "payments not configured" state.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_PRO=
